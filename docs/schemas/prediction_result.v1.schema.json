{
  "$defs": {
    "EventTime": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "elliptic_time_step",
            "block_height"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "EventTime",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "transaction_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transaction Id"
    },
    "source_dataset": {
      "anyOf": [
        {
          "enum": [
            "elliptic",
            "zenodo"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Dataset"
    },
    "event_time": {
      "anyOf": [
        {
          "$ref": "#/$defs/EventTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "score_type": {
      "anyOf": [
        {
          "enum": [
            "illicit_probability",
            "isolation_forest_anomaly_score"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score Type"
    },
    "score_percentile": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Zenodo only: rank within fit window",
      "title": "Score Percentile"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threshold"
    },
    "flagged": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Flagged"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "graph_context": {
      "anyOf": [
        {
          "enum": [
            "complete",
            "partial",
            "not_required",
            "not_available"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Graph Context"
    },
    "status": {
      "enum": [
        "scored",
        "skipped_coinbase",
        "skipped_invalid_input",
        "rejected_incomplete_graph_context",
        "rejected_invalid_event",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "produced_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Produced At"
    },
    "processing_time": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "when the consumer started processing",
      "title": "Processing Time"
    },
    "scored_at": {
      "title": "Scored At",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "PredictionResult",
  "type": "object"
}