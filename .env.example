# Copy to .env (git-ignored) or set in the shell. Placeholders only; there are no secrets in this project.
# PowerShell:  $env:BSAD_KAFKA_BOOTSTRAP = "127.0.0.1:29092"

# Java runtime used for Spark and Kafka (must contain bin\java.exe; Java 8/11/17)
BSAD_JAVA_HOME=C:\Program Files\Java\jre1.8.0_451

# Local Kafka (scripts/local_kafka.py)
BSAD_KAFKA_HOME=D:\blockchainbigdata\tools\kafka_2.13-3.7.2
BSAD_KAFKA_DATA=D:\blockchainbigdata\blockchain-streaming-anomaly-detection\data\kafka_data
BSAD_KAFKA_BOOTSTRAP=127.0.0.1:29092
BSAD_EVENTS_TOPIC=bsad.events.v1

# Model locations (default: newest version under artifacts/models/<dataset>/)
BSAD_ELLIPTIC_MODEL_ROOT=artifacts/models/elliptic
BSAD_ZENODO_MODEL_ROOT=artifacts/models/zenodo
# BSAD_ELLIPTIC_BUNDLE=artifacts/models/elliptic/1.0.0
# BSAD_ZENODO_MODEL=artifacts/models/zenodo/1.0.0

# Streaming run directory the dashboard shows by default
BSAD_STREAM_RUN_DIR=data/streaming/demo

# Keep pip's cache on D:
PIP_CACHE_DIR=D:\blockchainbigdata\pip_cache
